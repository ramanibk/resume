% Restrained technical resume styling for Tectonic, XeLaTeX, or LuaLaTeX.
\RequirePackage{iftex}
\ifPDFTeX
  \PackageError{scimisc-cv}{This resume requires XeLaTeX or LuaLaTeX}
    {Build with `tectonic main.tex`, `xelatex main.tex`, or `lualatex main.tex`.}
\fi

\RequirePackage{fontspec}
\RequirePackage{geometry}
\RequirePackage{enumitem}
\RequirePackage{xparse}
\RequirePackage{needspace}
\RequirePackage{xcolor}
\RequirePackage[compact,explicit]{titlesec}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{fontawesome5}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{url}

\setmainfont{SourceSans3-Regular.otf}[
  Path=assets/fonts/,
  ItalicFont=SourceSans3-It.otf,
  BoldFont=SourceSans3-Bold.otf,
  BoldItalicFont=SourceSans3-Bold.otf
]
\setsansfont{SourceSans3-Regular.otf}[
  Path=assets/fonts/,
  ItalicFont=SourceSans3-It.otf,
  BoldFont=SourceSans3-Bold.otf,
  BoldItalicFont=SourceSans3-Bold.otf
]
\newfontfamily\cvsemibold{SourceSans3-Semibold.otf}[Path=assets/fonts/]
\newfontfamily\cvemployerfont{SourceSans3-Semibold.otf}[Path=assets/fonts/]
\newfontface\cvsectiontype{Baskerville SemiBold Italic}
\renewcommand{\familydefault}{\sfdefault}

\providecommand{\cvpaperhex}{FBF8F4}
\providecommand{\cvheadinghex}{111111}
\providecommand{\cvemployerhex}{222222}
\providecommand{\cvbodyhex}{333333}
\providecommand{\cvemphasishex}{444444}
\providecommand{\cvaccenthex}{77736F}
\providecommand{\cvmutedhex}{686868}
\providecommand{\cvseparatorhex}{A0A0A0}
\definecolor{cvblack}{HTML}{\cvheadinghex}
\definecolor{cvemployer}{HTML}{\cvemployerhex}
\definecolor{cvbody}{HTML}{\cvbodyhex}
\definecolor{cvemphasis}{HTML}{\cvemphasishex}
\definecolor{cvpaper}{HTML}{\cvpaperhex}
\definecolor{cvgold}{HTML}{\cvaccenthex}
\definecolor{cvmuted}{HTML}{\cvmutedhex}
\definecolor{cvseparator}{HTML}{\cvseparatorhex}
\providecommand{\cvlinkhex}{838960}
\providecommand{\cvbodypointsize}{11}
\providecommand{\cvbodylinesize}{12.3}
\providecommand{\cvpublicationpointsize}{11}
\providecommand{\cvpublicationlinesize}{13.1}
\providecommand{\cvpublicationbreak}{\newpage}
\providecommand{\cvafterawardsbreak}{}
\providecommand{\cvitemsep}{3.5pt}
\providecommand{\cvjobsepspace}{10.5pt}
\providecommand{\cvsectionbeforespace}{14pt}
\providecommand{\cvsectionafterspace}{7.3pt}
\providecommand{\cvdoiafterspace}{8pt}
\providecommand{\cvbodyalignment}{\raggedright}
\definecolor{cvlinkaccent}{HTML}{\cvlinkhex}
\color{cvbody}
\pagecolor{cvpaper}

\geometry{a4paper,left=0.56in,right=0.56in,top=0.48in,bottom=0.55in,footskip=18pt}
\hypersetup{
  colorlinks=false,
  pdfborder={0 0 0}
}
\urlstyle{same}

\def\scimisc@cvname{}
\def\scimisc@cvpersonalinfo{}
\newcommand{\cvname}[1]{\def\scimisc@cvname{#1}}
\newcommand{\cvpersonalinfo}[1]{\def\scimisc@cvpersonalinfo{#1}}

\newcommand{\cvnamefont}{\bfseries\fontsize{23}{24.5}\selectfont\color{cvblack}}
\newcommand{\cvcontactfont}{\fontsize{8.4}{10.2}\selectfont\color{cvmuted}}
\newcommand{\cvdate}[1]{{\fontsize{8.8}{10}\selectfont\color{cvmuted}#1}}
\newcommand{\cvbold}[1]{{\bfseries\color{cvblack}#1}}
\newcommand{\cvstrong}[1]{{\cvsemibold\color{cvemphasis}#1}}
\newcommand{\cvyear}[1]{{\cvsemibold #1}}
\newcommand{\cvlink}[2]{\href{#1}{#2}}
\newcommand{\cvcontactlink}[2]{\href{#1}{{\color{cvmuted}#2}}}
\newcommand{\cvprofilelink}[2]{\href{#1}{{\color{cvemphasis}#2}}}
\newcommand{\cviconlink}[2]{\href{#1}{{\fontsize{9.4}{10.2}\selectfont\color{cvemphasis}#2}}}
\newcommand{\cvcontactseparator}{%
  \hspace{0.7em}{\color{cvseparator}\textperiodcentered}\hspace{0.7em}%
}
\newcommand{\cvcontactlinebreak}{\\[-0.4pt]}
\newlength{\cvpublicationhang}
\setlength{\cvpublicationhang}{0.21in}
\newcommand{\cvdoi}[1]{%
  \par\vspace{1pt}%
  \noindent\hspace*{\cvpublicationhang}%
    {\fontsize{9.1}{10.2}\selectfont\color{cvmuted}\cvlink{https://doi.org/#1}{doi:#1}\par}%
  \vspace{\cvdoiafterspace}%
}
\newcommand{\cvnote}[1]{%
  \par\vspace{1pt}{\fontsize{9.1}{10.2}\selectfont\itshape\color{cvmuted}#1\par}%
}

\newcommand{\makecvtitle}{%
  \noindent
  \begin{minipage}[c]{0.56\linewidth}%
    {\cvnamefont\MakeUppercase{\scimisc@cvname}\par}%
  \end{minipage}%
  \hfill
  \begin{minipage}[c]{0.42\linewidth}%
    \raggedleft
    {\cvcontactfont\scimisc@cvpersonalinfo\par}%
  \end{minipage}\par
  \vspace{11pt}%
  \fontsize{\cvbodypointsize}{\cvbodylinesize}\selectfont
}

\NewDocumentCommand{\cvsubsection}{m o o o}{%
  \needspace{4\baselineskip}%
  \noindent{\cvemployerfont\fontsize{11.4}{12.2}\selectfont\color{cvemployer}#1}%
  \IfValueT{#2}{\hfill\cvdate{#2}}%
  \par\vspace{2pt}%
  \IfValueT{#3}{{\fontsize{10}{11}\selectfont\itshape\color{cvmuted}#3}}%
  \IfValueT{#4}{\hfill{\fontsize{9.2}{10.2}\selectfont\itshape\color{cvmuted}#4}}%
  \par
}

\newcommand{\educationentry}[4]{%
  \noindent{\cvsemibold\fontsize{10.8}{11.7}\selectfont\color{cvemployer}#1}%
  {\color{cvseparator}\enspace\textperiodcentered\enspace}%
  {\fontsize{9.6}{10.6}\selectfont\itshape\color{cvmuted}#2}%
  \hfill{\fontsize{8.8}{10}\selectfont\color{cvmuted}#3}\par
  {\fontsize{10}{11}\selectfont\itshape\color{cvmuted}#4\par}%
}

\newcommand{\jobseparator}{\par\vspace{\cvjobsepspace}}

\newcommand{\awardentry}[4]{%
  \noindent{\cvbold{#1}}\hfill\cvdate{#2}\par
  \vspace{1.4pt}%
  {\color{cvbody}\cvstrong{#3}. #4\par}%
}

\newlength{\cvsectiontitlewidth}
\newcommand{\cvsectionfont}{\cvsectiontype\addfontfeatures{LetterSpace=0.25}}
\newcommand{\cvsectionheading}[1]{%
  \settowidth{\cvsectiontitlewidth}{{\cvsectionfont #1}}%
  \noindent{\cvsectionfont #1}%
  \hspace{0.8em}%
  \raisebox{0.55ex}{\color{cvgold}%
    \rule{\dimexpr\linewidth-\cvsectiontitlewidth-0.8em\relax}{0.9pt}}%
}
\titleformat{\section}
  {\fontsize{16.2}{17.2}\selectfont\color{cvblack}}
  {}{0pt}{\cvsectionheading{#1}}
\titlespacing*{\section}{0pt}{\cvsectionbeforespace}{\cvsectionafterspace}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{1.4em}
\setlist[itemize]{
  label={\color{cvemphasis}\small\textbullet},
  leftmargin=1.16em,
  itemsep=\cvitemsep,
  topsep=1.4pt,
  parsep=0pt,
  partopsep=0pt
}

\newenvironment{publicationlist}{%
  \par
  \begingroup
  \setcounter{cvpublication}{0}%
  \fontsize{\cvpublicationpointsize}{\cvpublicationlinesize}\selectfont
}{%
  \par\endgroup
}

\newcounter{cvpublication}
\setlength{\cvpublicationhang}{0.36in}
\newcommand{\publicationitem}{%
  \stepcounter{cvpublication}%
  \par\noindent\hangindent=\cvpublicationhang\hangafter=1\relax
  \makebox[\cvpublicationhang][l]{{\fontsize{9.1}{10}\selectfont\color{cvmuted}[\arabic{cvpublication}]}}%
}

\newcommand{\skillrow}[2]{%
  \noindent\makebox[1.24in][l]{{\cvsemibold\fontsize{9.1}{10.4}\selectfont\color{cvemphasis}\MakeUppercase{#1}}}%
  {\color{cvbody}#2}\par\vspace{1.4pt}%
}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[R]{{\cvsemibold\fontsize{8.2}{9}\selectfont\color{cvmuted}\thepage\ / \pageref*{LastPage}}}

\AtBeginDocument{%
  \fontsize{11}{12.3}\selectfont
  \hyphenpenalty=10000
  \exhyphenpenalty=10000
  \tolerance=2200
  \cvbodyalignment
}
\setcounter{secnumdepth}{0}
