\NewDocumentCommand{\cvsubsection}{m o o o}{%
  \needspace{5\baselineskip}%
  \noindent\textbf{#1}%
  \IfValueT{#2}{\hfill #2}%
  \par
  \IfValueT{#3}{\emph{#3}}%
  \IfValueT{#4}{\hfill\emph{#4}}%
  \par\vspace{1pt}
}

\geometry{a4paper,margin=0.75in}
\titleformat{\section}
  {\bfseries\rmfamily\large}{\thesection}{0pt}{\MakeTextUppercase{#1}}
\titlespacing*{\section}{0pt}{10pt}{4pt}
\titleformat{\subsection}
  {\bfseries\normalsize}{\thesubsection}{0pt}{#1}
\titlespacing*{\subsection}{0pt}{7pt}{2pt}
\setlength{\parindent}{0pt}
\setlength{\parskip}{2pt}
\setlist[itemize]{label=\textbullet,leftmargin=1.4em,itemsep=2pt,topsep=2pt,parsep=0pt,partopsep=0pt}
\AtBeginDocument{\fontsize{10.5pt}{12.5pt}\selectfont}

\pagestyle{empty}
\setcounter{secnumdepth}{0}
