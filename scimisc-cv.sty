\def\scimisc@cvname{}
\def\scimisc@cvpersonalinfo{}
\def\cvinfosep{\hfill|\hfill{}}

\newcommand{\cvname}[1]{\def\scimisc@cvname{#1}}
\newcommand{\cvpersonalinfo}[1]{\def\scimisc@cvpersonalinfo{#1}}

%\newcommand{\cvtitlefamily}{\ttfamily}
%\newcommand{\cvnamefont}{\cvtitlefamily\fontsize{16}{20}\selectfont}
%\newcommand{\cvpersonalinfofamily}{\ttfamily}
%\newcommand{\cvpersonalinfofont}{\cvpersonalinfofamily\normalsize\selectfont}

\newcommand{\cvtitlefamily}{\ttfamily\bfseries} % Monospace, bold for title
\newcommand{\cvnamefont}{\cvtitlefamily\huge\selectfont} % Monospace, bold for name
\newcommand{\cvpersonalinfofont}{\ttfamily\normalsize} % Monospace, smaller for personal info

\newcommand{\makecvtitle}{%
  \noindent\makebox[\linewidth][c]{%
    {\cvnamefont\MakeTextUppercase{\scimisc@cvname}}%
    \hfill
    {\cvpersonalinfofont\scimisc@cvpersonalinfo}%
  }%
  \par\vspace{5pt}
  \hrule height 0.4pt
  \vspace{3pt}
}



